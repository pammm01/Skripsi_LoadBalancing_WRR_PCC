;
; BIND reverse data file for local loopback interface
;
$TTL	604800
@	IN	SOA	loadbalancing.ac.id. root.loadbalancing.ac.id. (
			      1		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
@	IN	NS	loadbalancing.ac.id.
4	IN	PTR	loadbalancing.ac.id.
