;
; BIND data file for local loopback interface
;
$TTL	604800
@	IN	SOA	loadbalancing.ac.id. root.loadbalancing.ac.id. (
			      2		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
@	IN	NS	loadbalancing.ac.id.
@	IN	A	192.168.54.4
www	IN	A	192.168.54.4
mail	IN	A	192.168.54.4
db	IN	A	192.168.54.4
